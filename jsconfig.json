{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/app/*"],
      "styles/*": ["src/assets/styles/*"],
      "fonts/*": ["src/assets/fonts/Rajdhani/*"],
      "constants/*": ["src/app/consts/*"],
      "utils/*": ["src/app/helpers/*"],
      "pages/*": ["src/app/views/*"],
      "sections/*": ["src/app/blocks/*"],
      "lib/*": ["src/app/lib/*"]
    }
  },
  "exclude": ["dist", "node_modules"]
}

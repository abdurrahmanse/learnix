# ===========================================================
# Learnix Monorepo — Environment Variables Reference
# ===========================================================
# Copy the relevant sections into the respective app .env files.
# NEVER commit actual .env files with real secrets.
# ===========================================================

# ---- apps/api/.env ----------------------------------------
# (FastAPI backend — copy to apps/api/.env)

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/learnix

# Auth
SECRET_KEY=supersecretkey-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin seed user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Cloudinary
CLOUDINARY_CLOUD_NAME=learnix
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Debug mode (set to false in production)
DEBUG=true


# ---- apps/web/.env.local ----------------------------------
# (Next.js frontend — copy to apps/web/.env.local)

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

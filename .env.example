# ===========================================================
# Learnix Monorepo — Production Environment Variables
# ===========================================================

# -----------------------------------------------------------
# [BACKEND] apps/api/.env (FastAPI)
# -----------------------------------------------------------

# Environment & Server
ENVIRONMENT=development # options: development, staging, production
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME=Learnix
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/learnix

# Redis (Caching, Rate Limiting, ARQ)
REDIS_URL=redis://localhost:6379/0

# Authentication Secrets
# Generate using: openssl rand -hex 32
SECRET_KEY=supersecretkey-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Storage (Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=learnix
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Observability (Sentry)
SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0


# -----------------------------------------------------------
# [FRONTEND] apps/web/.env.local (Web App)
# -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_STUDENT_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/1


# -----------------------------------------------------------
# [FRONTEND] apps/student/.env.local (Student Portal)
# -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_STUDENT_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/2


# -----------------------------------------------------------
# [FRONTEND] apps/admin/.env.local (Admin Dashboard)
# -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/3

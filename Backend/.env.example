# ─────────────────────────────────────────────────
# DataSci Academy — Backend Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────────

# App
APP_NAME=DataSci Academy
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-256-bit-random-secret
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/datasci_academy

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_3_MONTHS=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_12_MONTHS=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET_NAME=datasci-academy
STORAGE_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
STORAGE_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
STORAGE_PUBLIC_URL=https://files.yourdomain.com

# Video CDN (BunnyNet)
BUNNY_STREAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BUNNY_STREAM_LIBRARY_ID=xxxxxxxx
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net

# Email (Resend / SendGrid)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@yourdomain.com

# CORS
CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]
